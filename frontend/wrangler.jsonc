{
  "$schema": "node_modules/wrangler/config-schema.json",
  "main": "worker/index.ts",
  "name": "radyjko",
  "compatibility_date": "2025-04-06",
  "compatibility_flags": [
    "nodejs_compat",
    "global_fetch_strictly_public"
  ],
  "observability": {
    "logs": {
      "enabled": true,
      "invocation_logs": true
    },
    "traces": {}
  },
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "NOWPLAYING_DO",
        "class_name": "NowPlayingDO"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["NowPlayingDO"]
    }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "radyjko-db",
      "database_id": "bc9af6b1-0c87-4837-8d4e-51ea1f8e0f17",
      "remote": true
    }
  ]
}
