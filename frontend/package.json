{
  "name": "radyjko",
  "version": "3.1.5",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit -p tsconfig.app.json && tsc --noEmit -p tsconfig.worker.json && vite build",
    "build:desktop": "tsc --noEmit -p tsconfig.app.json && tsc --noEmit -p tsconfig.worker.json && vite build --mode desktop",
    "preview": "vite preview",
    "deploy": "bun run build && wrangler deploy",
    "lint": "eslint .",
    "test": "bun test",
    "cf-typegen": "wrangler types --env-interface CloudflareEnv --include-runtime false src/cloudflare-env.d.ts",
    "tauri": "tauri",
    "desktop:dev": "tauri dev",
    "desktop:build": "tauri build",
    "android:init": "tauri android init",
    "android:dev": "tauri android dev",
    "android:build": "tauri android build"
  },
  "dependencies": {
    "@tauri-apps/api": "2.11.1",
    "hls.js": "1.6.15",
    "lucide-react": "1.7.0",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-router-dom": "7.18.1"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.44.0",
    "@cloudflare/workers-types": "4.20260412.1",
    "@eslint/js": "10.0.1",
    "@tailwindcss/postcss": "4.2.2",
    "@tauri-apps/cli": "2.11.4",
    "@types/node": "20.19.39",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.3",
    "eslint": "9.39.4",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.3",
    "tailwindcss": "4.2.2",
    "typescript": "5.9.3",
    "typescript-eslint": "8.63.0",
    "vite": "8.1.4",
    "wrangler": "4.110.0"
  }
}
